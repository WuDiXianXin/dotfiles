binds {

    // === Keybindings ===
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

    // === noctalia-shell keybinds ===
    // https://docs.noctalia.dev/getting-started/keybinds/


    // === niri recent-windows 默认快捷键 ===
    // recent-windows 是一个独立的配置段，专门用来定义 Alt-Tab 窗口切换器的行为
    // recent-windows {
        // binds {
            // 在【当前显示器】切换【最近使用的窗口】
            // Mod+Tab                                      { next-window scope="output"; }
            // Alt+Tab                                      { next-window scope="output"; }
            // 反向切换（往回选）
            // Mod+Shift+Tab                                { previous-window scope="output"; }
            // Alt+Shift+Tab                                { previous-window scope="output"; }

            // Grave 就是键盘按键 ` 和 ~
            // 只切换【同一个应用的多个窗口】
            // Mod+Grave                                    { next-window filter="app-id"; }
            // Alt+Grave                                    { next-window filter="app-id"; }
            // 同一个应用内反向切换窗口
            // Mod+Shift+Grave                              { previous-window filter="app-id"; }
            // Alt+Shift+Grave                              { previous-window filter="app-id"; }
        // }
    // }

    
    // === System & Overview ===
	// 打开/关闭工作区总览界面
	Mod+O                                      repeat=false { toggle-overview; }
    // 退出 Niri
    Mod+Shift+E                                repeat=false { quit; }
    // 关闭显示屏
    Mod+Shift+P                                repeat=false { power-off-monitors; }
	// 禁用/启用所有快捷键（避免游戏误触）
	Mod+Escape          repeat=false allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }


	// === Application Launchers ===
    // 打开软件
    Mod+Return                                 repeat=false { spawn "foot"; }
    Mod+B                                      repeat=false { spawn "firefox"; }
    Mod+E                                      repeat=false { spawn "nautilus"; }


    // === Noctalia ===
	// 应用搜索器
    Mod+Space                                  repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    // 壁纸
    Mod+Shift+Return                           repeat=false { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    // 控制中心
    Mod+S                                      repeat=false { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    // 设置
    Mod+Shift+S                                repeat=false { spawn "noctalia" "msg" "settings-toggle"; }
    // 锁屏
    Mod+Alt+L                                  repeat=false { spawn "noctalia" "msg" "session" "lock"; }
    // 电源按键操作
    Mod+Shift+Q                                repeat=false { spawn "noctalia" "msg" "panel-toggle" "session"; }


    // === Media Controls ===
	// 音量加减 5%
    XF86AudioRaiseVolume             allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume             allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
	// 切换静音
    XF86AudioMute       repeat=false allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
	// 麦克风静音
    XF86AudioMicMute    repeat=false allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
	// 播放
    XF86AudioPlay       repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "play"; }
	// 暂停
    XF86AudioPause      repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "stop"; }
	// 上一曲
    XF86AudioPrev       repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
	// 下一曲
    XF86AudioNext       repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }


    // === Brightness Controls ===
	// 亮度加减 10%
    XF86MonBrightnessUp              allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown            allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }


	// === Window Management && Layout Controls ===
	// 关闭当前窗口
    Mod+Q                                      repeat=false { close-window; }

	// 切换列标签显示
    Mod+W                                      repeat=false { toggle-column-tabbed-display; }

    // 让当前窗口在“平铺”和“浮动”两种状态之间切换
    Mod+V                                      repeat=false { toggle-window-floating; }
    // 在浮动窗口层和平铺窗口层之间切换键盘焦点
    Mod+Shift+V                                repeat=false { switch-focus-between-floating-and-tiling; }

	// 切换列宽度预设
	Mod+R                                      repeat=false { switch-preset-column-width; }
	// 切换窗口高度预设
	Mod+Shift+R                                repeat=false { switch-preset-window-height; }
	// 重置窗口高度
	Mod+Ctrl+R                                 repeat=false { reset-window-height; }

	// 最大化当前列
    Mod+F                                      repeat=false { maximize-column; }
	// 窗口全屏
    Mod+Shift+F                                repeat=false { fullscreen-window; }
	// 扩展当前列到最大宽度
    Mod+Ctrl+F                                 repeat=false { expand-column-to-available-width; }
    // 将当前聚焦的窗口最大化到工作区的边缘，也就是让这个窗口铺满整个工作区，覆盖住其他窗口，类似传统窗口管理器的“最大化”操作
    Mod+M                                      repeat=false { maximize-window-to-edges; }

	// 居中当前列
    Mod+C                                      repeat=false { center-column; }
	// 居中所有可见列
	Mod+Ctrl+C                                 repeat=false { center-visible-columns; }


	// === 窗口 合并 or 拆分 到左右列 ===
    // 智能 合并 or 分离
    Mod+BracketLeft                            repeat=false { consume-or-expel-window-left; }
    Mod+BracketRight                           repeat=false { consume-or-expel-window-right; }
    // 单向操作，用于将相邻列的窗口吸收到当前列中
    Mod+Comma                                  repeat=false { consume-window-into-column; }
    // 单向操作，用于将当前列中的某个窗口分离出来，使其成为一个独立的列
    Mod+Period                                 repeat=false { expel-window-from-column; }


	// === Manual Sizing ===
	// 列宽-10%
    Mod+Minus                                  repeat=false { set-column-width "-10%"; }
	// 列宽+10%
    Mod+Equal                                  repeat=false { set-column-width "+10%"; }
	// 窗口高度-10%
    Mod+Shift+Minus                            repeat=false { set-window-height "-10%"; }
	// 窗口高度+10%
    Mod+Shift+Equal                            repeat=false { set-window-height "+10%"; }


    // === Window Movement and Focus ===
    Mod+Home                                   repeat=false { focus-column-first; }
    Mod+End                                    repeat=false { focus-column-last; }
    Mod+Ctrl+Home                              repeat=false { move-column-to-first; }
    Mod+Ctrl+End                               repeat=false { move-column-to-last; }

    Mod+H                                      repeat=false { focus-column-left; }
    Mod+L                                      repeat=false { focus-column-right; }
    Mod+K                                      repeat=false { focus-window-up; }
    Mod+J                                      repeat=false { focus-window-down; }

    Mod+Ctrl+H                                 repeat=false { move-column-left; }
    Mod+Ctrl+L                                 repeat=false { move-column-right; }
    Mod+Ctrl+K                                 repeat=false { move-window-up; }
    Mod+Ctrl+J                                 repeat=false { move-window-down; }

    Mod+Shift+H                                repeat=false { focus-monitor-left; }
    Mod+Shift+L                                repeat=false { focus-monitor-right; }
    Mod+Shift+K                                repeat=false { focus-monitor-up; }
    Mod+Shift+J                                repeat=false { focus-monitor-down; }

    Mod+Shift+Ctrl+H                           repeat=false { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L                           repeat=false { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+K                           repeat=false { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+J                           repeat=false { move-column-to-monitor-down; }


    // === Workspace Navigation ===
	// 切换上下工作区
	Mod+U                                      repeat=false { focus-workspace-down; }
	Mod+I                                      repeat=false { focus-workspace-up; }
	// 移动当前列到上下工作区
	Mod+Ctrl+U                                 repeat=false { move-column-to-workspace-down; }
	Mod+Ctrl+I                                 repeat=false { move-column-to-workspace-up; }


    // === Workspace Switching ===
    Mod+1                                      repeat=false { focus-workspace 1; }
    Mod+2                                      repeat=false { focus-workspace 2; }
    Mod+3                                      repeat=false { focus-workspace 3; }
    Mod+4                                      repeat=false { focus-workspace 4; }
    Mod+5                                      repeat=false { focus-workspace 5; }
    Mod+6                                      repeat=false { focus-workspace 6; }
    Mod+7                                      repeat=false { focus-workspace 7; }
    Mod+8                                      repeat=false { focus-workspace 8; }
    Mod+9                                      repeat=false { focus-workspace 9; }

    Mod+Ctrl+1                                 repeat=false { move-column-to-workspace 1; }
    Mod+Ctrl+2                                 repeat=false { move-column-to-workspace 2; }
    Mod+Ctrl+3                                 repeat=false { move-column-to-workspace 3; }
    Mod+Ctrl+4                                 repeat=false { move-column-to-workspace 4; }
    Mod+Ctrl+5                                 repeat=false { move-column-to-workspace 5; }
    Mod+Ctrl+6                                 repeat=false { move-column-to-workspace 6; }
    Mod+Ctrl+7                                 repeat=false { move-column-to-workspace 7; }
    Mod+Ctrl+8                                 repeat=false { move-column-to-workspace 8; }
    Mod+Ctrl+9                                 repeat=false { move-column-to-workspace 9; }


    // === Screenshots ===
	// 区域截图
    // Print                                   repeat=false { screenshot; }
    Print                                      repeat=false { spawn "noctalia" "msg" "screenshot-region"; }
	// 当前显示器全屏截图
    // Ctrl+Print                              repeat=false { screenshot-screen; }
    Ctrl+Print                                 repeat=false { spawn "noctalia" "msg" "screenshot-fullscreen"; }
	// 窗口截图
    Alt+Print                                  repeat=false { screenshot-window; }
}
