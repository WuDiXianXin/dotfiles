animations {
    // 原来的1/2速度
    // slowdown 2.0

    // 概览界面开合动画
    overview-open-close {
        spring damping-ratio=0.8 stiffness=400 epsilon=0.0001
    }

    //工作区切换的动画
    workspace-switch {
        spring damping-ratio=0.7 stiffness=600 epsilon=0.00001
    }

    //视角平移的动画
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=600 epsilon=0.00001
    }

    //窗口打开的动画
    window-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    //窗口关闭的动画
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }

    //窗口位置发生变动的动画
    window-movement {
        spring damping-ratio=0.7 stiffness=800 epsilon=0.0001
    }

    //窗口大小发生变化的动画
    window-resize {
        spring damping-ratio=0.7 stiffness=800 epsilon=0.0001
    }

    // 配置通知开合动画
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }

    // 退出确认框开合动画
    exit-confirmation-open-close {
        spring damping-ratio=0.6 stiffness=500 epsilon=0.01
    }

    // 截图界面打开动画
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
}
